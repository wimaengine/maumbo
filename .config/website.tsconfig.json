{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "../src/content.config.js",
    "../astro.config.mjs",
    ".astro/types.d.ts"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "baseUrl": "..",
    "types": [
      "astro/client",
      "node"
    ],
    "composite": true,
    "noEmit": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".."
  }
}
